# Frontend (Vite)


# Backend core
PORT=3000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/solutionhub
JWT_SECRET=change-this-to-a-strong-secret

# Payments
RAZORPAY_KEY_ID=rzp_live_or_test_key
RAZORPAY_KEY_SECRET=razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=razorpay_webhook_secret

# AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Secure Admin Login (Google + 2FA)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
ADMIN_ALLOWED_EMAILS=admin1@gmail.com,admin2@gmail.com
ADMIN_2FA_SECRET=BASE32_TOTP_SECRET_FOR_SINGLE_ADMIN
# Optional per-admin secrets (JSON object):
# ADMIN_2FA_SECRETS={"admin1@gmail.com":"BASE32SECRET1","admin2@gmail.com":"BASE32SECRET2"}

# Legacy admin secret fallback (optional, not recommended long-term)
ADMIN_SECRET=legacy-admin-secret
