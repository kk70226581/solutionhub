# Frontend (Vite)


# Backend core
PORT=3000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/solutionhub
JWT_SECRET=change-this-to-a-strong-secret
PASSWORD_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_GLOBAL=300
RATE_LIMIT_MAX_AUTH=20
PUBLIC_API_URL=https://solutionhub66.onrender.com
REDIS_URL=redis://localhost:6379
CACHE_EXPERTS_TTL_SEC=120
CACHE_HOME_TTL_SEC=60

# Password reset email delivery
# EMAIL_PROVIDER: none | resend | sendgrid
EMAIL_PROVIDER=none
EMAIL_FROM=no-reply@yourdomain.com
FRONTEND_URL=https://your-frontend-domain.com
PUBLIC_APP_URL=https://your-frontend-domain.com
FRONTEND_ROUTER_MODE=hash
RESEND_API_KEY=
SENDGRID_API_KEY=

# Payments
RAZORPAY_KEY_ID=rzp_live_or_test_key
RAZORPAY_KEY_SECRET=razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=razorpay_webhook_secret

# AI Expert - AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Preferred: Bedrock project API key (OpenAI-compatible Mantle API).
BEDROCK_PROJECT_API_KEY=
BEDROCK_MANTLE_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
# Cheapest verified general text-chat model in this project.
AI_EXPERT_PROVIDER=bedrock
BEDROCK_MODEL_ID=google.gemma-3-4b-it
AI_EXPERT_MAX_TOKENS=800
AI_EXPERT_TEMPERATURE=0.35
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=50

# Google login/signup for clients and secure admin login
# Add your frontend domains in Google Cloud OAuth Authorized JavaScript origins.
# Development: http://localhost:5173 (use localhost, not 127.0.0.1).
# Production: https://your-frontend-domain.example (no path or trailing slash).
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Secure Admin Login (Google + 2FA)
ADMIN_ALLOWED_EMAILS=admin1@gmail.com,admin2@gmail.com
ADMIN_2FA_SECRET=BASE32_TOTP_SECRET_FOR_SINGLE_ADMIN
# Optional per-admin secrets (JSON object):
# ADMIN_2FA_SECRETS={"admin1@gmail.com":"BASE32SECRET1","admin2@gmail.com":"BASE32SECRET2"}

# Legacy admin secret fallback (optional, not recommended long-term)
ADMIN_SECRET=legacy-admin-secret
